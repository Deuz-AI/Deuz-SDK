{
  "scenario": "xai.grok-4.3.call-options",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://api.x.ai/v1/chat/completions",
      "headers": {
        "authorization": "Bearer <secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "grok-4.3",
        "messages": [
          {
            "role": "user",
            "content": "Say hello."
          }
        ],
        "stream": true,
        "max_tokens": 256,
        "temperature": 0.2,
        "top_p": 0.9,
        "stop": ["END"],
        "reasoning_effort": "low",
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
