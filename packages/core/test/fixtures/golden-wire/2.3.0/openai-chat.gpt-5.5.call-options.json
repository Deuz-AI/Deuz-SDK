{
  "scenario": "openai-chat.gpt-5.5.call-options",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://api.openai.com/v1/chat/completions",
      "headers": {
        "authorization": "Bearer <secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "gpt-5.5",
        "messages": [
          {
            "role": "user",
            "content": "Say hello."
          }
        ],
        "stream": true,
        "max_completion_tokens": 256,
        "stop": ["END"],
        "reasoning_effort": "low",
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
