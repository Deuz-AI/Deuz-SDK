{
  "scenario": "yunwu.gpt-5.2.generate-text",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://yunwu.ai/v1/chat/completions",
      "headers": {
        "authorization": "Bearer <secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "gpt-5.2",
        "messages": [
          {
            "role": "developer",
            "content": "You are a concise assistant."
          },
          {
            "role": "user",
            "content": "Say hello."
          }
        ],
        "stream": true,
        "max_completion_tokens": 128000,
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
