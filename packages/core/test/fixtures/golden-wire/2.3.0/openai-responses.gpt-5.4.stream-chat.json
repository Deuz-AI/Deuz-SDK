{
  "scenario": "openai-responses.gpt-5.4.stream-chat",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://api.openai.com/v1/responses",
      "headers": {
        "authorization": "Bearer <secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "gpt-5.4",
        "input": [
          {
            "role": "user",
            "content": "What is 2 + 2?"
          },
          {
            "role": "assistant",
            "content": "4"
          },
          {
            "role": "user",
            "content": "And 3 + 3?"
          }
        ],
        "stream": true,
        "max_output_tokens": 128000,
        "store": false,
        "include": ["reasoning.encrypted_content"]
      }
    }
  ]
}
