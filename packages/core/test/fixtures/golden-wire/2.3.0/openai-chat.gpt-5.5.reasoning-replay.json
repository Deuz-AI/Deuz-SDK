{
  "scenario": "openai-chat.gpt-5.5.reasoning-replay",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://api.openai.com/v1/chat/completions",
      "headers": {
        "authorization": "Bearer <secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "gpt-5.5",
        "messages": [
          {
            "role": "user",
            "content": "Where should I travel?"
          },
          {
            "role": "assistant",
            "content": "Paris."
          },
          {
            "role": "user",
            "content": "Why?"
          }
        ],
        "stream": true,
        "max_completion_tokens": 128000,
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
