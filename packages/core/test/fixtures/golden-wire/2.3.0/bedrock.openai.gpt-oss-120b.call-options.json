{
  "scenario": "bedrock.openai.gpt-oss-120b.call-options",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://bedrock-mantle.us-west-2.api.aws/openai/v1/chat/completions",
      "headers": {
        "authorization": "Bearer <secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "openai.gpt-oss-120b",
        "messages": [
          {
            "role": "user",
            "content": "Say hello."
          }
        ],
        "stream": true,
        "max_tokens": 256,
        "temperature": 0.2,
        "top_p": 0.9,
        "stop": ["END"],
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
