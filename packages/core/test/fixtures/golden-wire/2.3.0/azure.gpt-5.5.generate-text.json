{
  "scenario": "azure.gpt-5.5.generate-text",
  "recordedFrom": "2.3.0",
  "requests": [
    {
      "method": "POST",
      "url": "https://golden-resource.openai.azure.com/openai/deployments/gpt-5.5/chat/completions?api-version=2024-12-01-preview",
      "headers": {
        "api-key": "<secret>",
        "content-type": "application/json"
      },
      "json": {
        "model": "gpt-5.5",
        "messages": [
          {
            "role": "developer",
            "content": "You are a concise assistant."
          },
          {
            "role": "user",
            "content": "Say hello."
          }
        ],
        "stream": true,
        "max_completion_tokens": 128000,
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
